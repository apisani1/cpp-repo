# Note: everything under `Checks:` is a folded YAML scalar, so `#` there is
# literal text, not a comment. Keep explanations outside the block.
#
# clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling is
# disabled because it recommends the C11 Annex K *_s functions, which neither
# macOS nor glibc implement.
#
# misc-include-cleaner is disabled because it demands a direct include of the
# header defining each symbol. Unity's macros live in unity_internals.h, which
# must not be included directly - unity.h is the public umbrella header. The
# check cannot see through that pattern.
#
# Two modernize checks are disabled because this project compiles C as well as
# C++, and C sources - plus the extern "C" headers pulled into every C++
# translation unit - must stay valid C:
#
#   modernize-use-trailing-return-type would rewrite declarations into C++-only
#   syntax.
#
#   modernize-redundant-void-arg would strip the `(void)` from C parameter
#   lists. That is only safe at C23, where `f()` and `f(void)` agree; at C17 and
#   below `-Wstrict-prototypes` rejects `f()` outright, so the check and the
#   project's own warning flags would demand opposite things. Note this check
#   ignores C sources up to clang-tidy 22 and flags them from 23 onwards, so
#   leaving it on makes the gate depend on the installed LLVM version.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  cert-*,

  -bugprone-easily-swappable-parameters,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -modernize-redundant-void-arg,
  -misc-include-cleaner,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-size,
  -readability-else-after-return

# Warnings are promoted to errors by the `tidy` build target
# (--warnings-as-errors=*), not here, so that clangd keeps showing them as
# warnings in the editor instead of errors.
WarningsAsErrors: ''

HeaderFilterRegex: '(^|.*/)(src|include|tests)/.*'

CheckOptions:

  - key: readability-function-cognitive-complexity.Threshold
    value: "25"

  - key: readability-function-size.LineThreshold
    value: "300"

  - key: readability-function-size.StatementThreshold
    value: "200"

  - key: readability-function-size.BranchThreshold
    value: "30"

  - key: readability-function-size.ParameterThreshold
    value: "6"

FormatStyle: file
