{
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.cmakePath": "/opt/homebrew/bin/cmake",
    "cmake.configureEnvironment": {
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/opt/homebrew/opt/llvm/bin"
    },
    "clangd.path": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/debug",
        "--background-index",
        "--clang-tidy",
        "--header-insertion=never"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "search.exclude": {
        "**/build": true
    },
    "files.watcherExclude": {
        "**/build/**": true
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.formatOnSave": true
    },
    "makefile.configureOnOpen": false
}
